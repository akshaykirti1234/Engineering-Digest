public class Main {
	public static void main(String[] args) {
		Function<String, Integer> function = x -> x.length();
		Function<String, String> function2 = s -> s.substring(0, 3);

		System.out.println(function2.apply("akshay"));
		System.out.println(function.apply("akshay"));

		Function<List<Student>, List<Student>> stuNmStrtWthVip = studentList -> {
			List<Student> filteredList = studentList.stream()
					.filter(student -> function2.apply(student.getName()).equalsIgnoreCase("vip")).toList();
			return filteredList;
		};

		Student student1 = new Student(1, "Akshay");
		Student student2 = new Student(2, "Vipul");
		Student student3 = new Student(3, "Vinak");
		Student student4 = new Student(4, "Viplab");

		List<Student> students = Arrays.asList(student1, student2, student3, student4);

		System.out.println(stuNmStrtWthVip.apply(students));

	}

	private static class Student {
		private int id;
		private String name;

		public int getId() {
			return id;
		}

		public void setId(int id) {
			this.id = id;
		}

		public String getName() {
			return name;
		}

		public void setName(String name) {
			this.name = name;
		}

		public Student(int id, String name) {
			super();
			this.id = id;
			this.name = name;
		}

		@Override
		public String toString() {
			return "Student [id=" + id + ", name=" + name + "]";
		}

	}
}