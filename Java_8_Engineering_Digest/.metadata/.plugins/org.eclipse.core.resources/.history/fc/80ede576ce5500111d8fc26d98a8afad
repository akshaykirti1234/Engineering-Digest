package tech.csm;

public class Main {
	public static void main(String[] args) {
		System.out.println("Start");

		Runnable myThread = () -> {
			for (int i = 1; i <= 10; i++) {
				System.out.println("Hello " + i);
			}
		};

		Thread thread = new Thread(myThread);
		thread.run();

		System.out.println("End");
	}
}
